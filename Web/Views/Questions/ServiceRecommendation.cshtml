@model Web.Models.ServiceRecommendationViewModel

<div style="padding: 20px; font-family: Arial, sans-serif;">
    <h2 style="text-align: center; margin-top: 0; padding-top: 50px; color: #4CAF50; font-size: 28px; font-weight: bold; z-index: 10; position: relative;">
        Recommended Services for Your Skin
    </h2>


    <!-- Skin Type Scores -->
    <div style="margin-bottom: 40px;">
        <h4 style="color: #333;">Skin Type Compatibility Scores</h4>
        <table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
            <thead>
                <tr style="background-color: #f2f2f2;">
                    <th style="padding: 10px; border: 1px solid #ddd;">Skin Type</th>
                    <th style="padding: 10px; border: 1px solid #ddd;">Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SkinTypes)
                {
                    <tr>
                        <td style="padding: 10px; border: 1px solid #ddd;">@item.Key.Name</td>
                        <td style="padding: 10px; border: 1px solid #ddd;">@item.Value.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Recommended Services -->
    <div>
        <h4 style="color: #333;">Recommended Services</h4>
        @if (Model.Services != null && Model.Services.Any())
        {
            <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; padding: 20px;">
                @foreach (var service in Model.Services)
                {
                    <div style="width: calc(25% - 20px); min-width: 250px; border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); transition: transform 0.3s ease-in-out;">
                        <img src="@service.Thumbnail" alt="@service.ServiceName" style="width: 100%; height: 180px; object-fit: cover;">
                        <div style="padding: 15px;">
                            <h5 style="color: #2196F3; margin-bottom: 10px; font-size: 18px;">@service.ServiceName</h5>
                            <p style="margin-bottom: 5px; font-size: 14px;"><strong>Duration:</strong> @service.Duration minutes</p>
                            <p style="margin-bottom: 5px; font-size: 14px;"><strong>Price:</strong> $@service.Price</p>

                            <a asp-controller="Services" asp-action="Details" asp-fragment="services-section" asp-route-id="@service.Id"
                               class="btn btn-outline-primary btn-sm px-2 py-2">Details</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color: red; text-align: center; font-size: 18px; margin-top: 20px;">No recommended services found.</p>
        }

    </div>
</div>
