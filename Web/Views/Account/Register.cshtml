@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign Up</title>
    <link rel="stylesheet" href="~/css/flaticon.css">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let inputs = document.querySelectorAll(".input-field");
            inputs.forEach(input => {
                input.addEventListener("focus", function () {
                    let label = this.parentNode.querySelector("label");
                    label.style.top = "5px";
                    label.style.left = "12px";
                    label.style.fontSize = "12px";
                    label.style.color = "#d9bf77";
                    this.style.borderColor = "#d9bf77";
                });

                input.addEventListener("blur", function () {
                    if (!this.value) {
                        let label = this.parentNode.querySelector("label");
                        label.style.top = "50%";
                        label.style.left = "12px";
                        label.style.fontSize = "16px";
                        label.style.color = "#636e72";
                    }
                    this.style.borderColor = "#dfe6e9";
                });
            });

            // Toggle Password Visibility
            document.querySelector("#togglePassword").addEventListener("click", function () {
                let passwordField = document.querySelector("#passwordField");
                let icon = this.querySelector("i");

                if (passwordField.type === "password") {
                    passwordField.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    passwordField.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            });
        });
    </script>
</head>

<body style="margin: 100px; padding: 0; font-family: Arial, sans-serif; background: linear-gradient(135deg, #f5f5f5, #fcedd2); height: 100vh; display: flex; justify-content: center; align-items: center;">

    <div style="width: 420px; background-color: white;  padding: 40px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); text-align: center;">
        <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 25px;">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-size: 24px; font-weight: bold; display: flex; align-items: center; color: #d9bf77; text-decoration: none;">
                <span class="flaticon-lotus" style="font-size: 30px; margin-right: 10px;"></span>
                Energen
            </a>
        </div>
        <h2 style="font-size: 28px; font-weight: bold; color: #636e72;">Register an account</h2>

        <form method="post" action="/account/register">

            <div style="position: relative; text-align: left; margin-bottom: 20px;">
                <label style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #636e72; transition: all 0.3s;">Email</label>
                <input type="email" name="Email" class="input-field" required
                       style="width: 100%; padding: 15px 12px; border: 1px solid #dfe6e9; border-radius: 6px; font-size: 16px; outline: none; transition: border-color 0.3s;">
            </div>

            <div style="position: relative; text-align: left; margin-bottom: 20px;">
                <label style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #636e72; transition: all 0.3s;">Phone</label>
                <input type="tel" name="Phone" class="input-field" required
                       style="width: 100%; padding: 15px 12px; border: 1px solid #dfe6e9; border-radius: 6px; font-size: 16px; outline: none; transition: border-color 0.3s;">
            </div>

            <div style="position: relative; text-align: left; margin-bottom: 20px;">
                <label style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #636e72; transition: all 0.3s;">Full Name</label>
                <input type="text" name="Fullname" class="input-field" required
                       style="width: 100%; padding: 15px 12px; border: 1px solid #dfe6e9; border-radius: 6px; font-size: 16px; outline: none; transition: border-color 0.3s;">
            </div>

            <div style="position: relative; text-align: left; margin-bottom: 20px;">
                <label style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #636e72; transition: all 0.3s;">Password</label>
                <input type="password" name="Password" id="passwordField" class="input-field" required
                       style="width: 100%; padding: 15px 12px; border: 1px solid #dfe6e9; border-radius: 6px; font-size: 16px; outline: none; transition: border-color 0.3s;">
                <span id="togglePassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #636e72;">
                    <i class="fas fa-eye"></i>
                </span>
            </div>

            <div style="position: relative; text-align: left; margin-bottom: 20px;">
                <select name="Gender" class="input-field"
                        style="width: 100%; padding: 15px 12px; border: 1px solid #dfe6e9; border-radius: 6px; font-size: 16px; outline: none; transition: border-color 0.3s;">
                    <option value="" disabled selected>Select your gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <button type="submit" style="width: 100%; padding: 12px; background-color: #d9bf77; border: 1px solid #d9bf77; border-radius: 6px; color: white; font-size: 18px; cursor: pointer; transition: all 0.3s;">
                Sign Up
            </button>

            <p style="margin-top: 18px; font-size: 16px; color: #636e72;">
                Already have an account? <a href="./Login" style="color: #0984e3; text-decoration: none;">Sign In</a>
            </p>
        </form>
    </div>

</body>
</html>
