@using BusinessObject.Enums
@model Web.Models.Account.AccountUpdateViewModel
@{
    Layout = null;
    ViewData["Title"] = "Profile";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .sidebar {
            height: 100vh;
            background-color: #f8f9fa;
            padding-top: 20px;
        }
        .sidebar .nav-link.active {
            font-weight: bold;
            color: #007bff;
        }
        .form-container {
            padding: 20px;
        }
    </style>
</head>
<body>
    <header class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
        <div class="logo">
            <h4>Your Logo</h4>
        </div>
        <nav>
            <ul class="nav">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/Service">Services</a></li>
                <li class="nav-item"><a class="nav-link" href="/Blog">Blog</a></li>
            </ul>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 sidebar">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" href="./Profile">My Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Bookings/History">Schedules</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Transaction">Payment History</a>
                    </li>
                </ul>
            </nav>

            <!-- Main content -->
            <main class="col-md-10">
                <div class="form-container">
                    <h3>User Profile</h3>
                    <form method="post" action="/account/update">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="username" asp-for="Username" value="@Model.Fullname" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" asp-for="Email" value="@Model.Email" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="fullname" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="fullname" asp-for="Fullname" value="@Model.Fullname" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="gender" class="form-label">Gender</label>
                            <select class="form-select" id="gender" asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" disabled>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" id="phone" asp-for="PhoneNumber" value="@Model.PhoneNumber" disabled>
                        </div>
                        <input type="hidden" id="id" asp-for="Id" value="@Model.Id">
                        <input type="hidden" id="role" value="@Model.Role">

                        <button type="button" class="btn btn-primary" id="edit-btn">Edit</button>
                        <button type="submit" class="btn btn-success d-none" id="save-btn">Save Changes</button>
                        <button type="button" class="btn btn-secondary d-none" id="discard-btn" asp-controller="Account" asp-action="Profile">Discard Changes</button>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <script>
        const editBtn = document.getElementById('edit-btn');
        const saveBtn = document.getElementById('save-btn');
        const discardBtn = document.getElementById('discard-btn');
        const inputs = document.querySelectorAll('input, select');

        editBtn.addEventListener('click', () => {
            inputs.forEach(input => input.disabled = false);
            editBtn.classList.add('d-none');
            saveBtn.classList.remove('d-none');
            discardBtn.classList.remove('d-none');
        });

        discardBtn.addEventListener('click', () => {
            inputs.forEach(input => input.disabled = true);
            editBtn.classList.remove('d-none');
            saveBtn.classList.add('d-none');
            discardBtn.classList.add('d-none');
            location.href = './Profile';
        });
    </script>
</body>
</html>