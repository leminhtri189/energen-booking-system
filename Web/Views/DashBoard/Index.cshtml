@using System.Globalization
@model DashBoardViewModel
@{
    Layout = "~/Views/Shared/_ManageAndDashBoardLayout.cshtml";
    var currentMonth = DateTime.Today.ToString("yyyy-MM");
    var totalAmountSuccess = Model.Transactions.PageContent
        .Where(t => t.Status == BusinessObject.Enums.PaymentStatus.Sussces && t.Amount.HasValue)
        .Sum(t => t.Amount ?? 0);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Transactions</h5>
                    <p class="card-text display-6">@totalAmountSuccess.ToString("C", CultureInfo.GetCultureInfo("en-US"))</p>
                </div>
            </div>
        </div>

        <!-- Card 1: Bookings -->
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Bookings</h5>
                    <p class="card-text display-6">@Model.Bookings.TotalItemCount</p>
                </div>
            </div>
        </div>

        <!-- Card 2: Transactions -->
        

        <!-- Card 3: Services -->
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Services</h5>
                    <p class="card-text display-6">@Model.Services.TotalItemCount</p>
                </div>
            </div>
        </div>

        <!-- Card 4: Users -->
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text display-6">@Model.Users.TotalItemCount</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <form method="get" class="mb-4">
        <div class="form-group row">
            <label class="col-form-label col-sm-2">Select Month:</label>
            <div class="col-sm-4">
                <input type="month" name="date" value="@ViewData["SelectedMonth"]" class="form-control" onchange="this.form.submit()" />
            </div>
        </div>
    </form>


    <!-- Chart Section -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Booking per Day (This Month)</h5>
            <canvas id="bookingChart" height="100"></canvas>
        </div>
    </div>

    <div class="row">
        <!-- Booking List -->
        <div class="col-md-6">
            <h4>Bookings</h4>
            <ul class="list-group">
                @foreach (var item in Model.Bookings.PageContent)
                {
                    <li class="list-group-item">Booking ID: @item.Id - @item.CreatedAt.ToShortDateString()</li>
                }
            </ul>
        </div>

        <!-- Transactions List -->
        <div class="col-md-6">
            <h4>Transactions</h4>
            <ul class="list-group">
                @foreach (var item in Model.Transactions.PageContent)
                {
                    <li class="list-group-item">Transaction: $@item.Amount - @item.CreatedAt.ToShortDateString()</li>
                }
            </ul>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Services List -->
        <div class="col-md-6">
            <h4>Services</h4>
            <ul class="list-group">
                @foreach (var item in Model.Services.PageContent)
                {
                    <li class="list-group-item">Service: @item.ServiceName</li>
                }
            </ul>
        </div>

        <!-- Users List -->
        <div class="col-md-6">
            <h4>Users</h4>
            <ul class="list-group">
                @foreach (var item in Model.Users.PageContent)
                {
                    <li class="list-group-item">User: @item.FullName</li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('bookingChart').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.BookingChart.Labels)), // Các ngày trong tháng
                datasets: [{
                    label: 'Bookings',
                    data: @Html.Raw(Json.Serialize(Model.BookingChart.BookingsData)), // Dữ liệu bookings
                    fill: false,
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        beginAtZero: true
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1, // Đảm bảo số nguyên
                            callback: function(value) {
                                return value.toFixed(0); // Hiển thị số nguyên
                            }
                        }
                    }
                }
            }
        });
    </script>
}
