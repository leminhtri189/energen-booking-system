@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}
<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar" style="background-image: url('/images/bg_1.jpg');" data-stellar-background-ratio="0.5">
    <div class="container">
        <div class="d-flex align-items-center">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" >
                <span class="flaticon-lotus"></span> Energen
            </a>
            <button class="navbar-toggler ml-3" type="button" data-toggle="collapse" data-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="oi oi-menu"></span> Menu
            </button>
        </div>
        <div class="collapse navbar-collapse justify-content-center" id="navbarContent">
            <ul class="navbar-nav">
                <li class="nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                </li>
                <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link">About</a></li>
                <li class="nav-item @(currentController == "Services" ? "active" : "")">
                    <a asp-controller="Services" asp-action="Index" asp-fragment="services-section" class="nav-link" id="servicesLink">Services</a>
                </li>
                <li class="nav-item @(currentController == "Therapists" ? "active" : "")">
                    <a asp-controller="Therapists" asp-action="Index" asp-fragment="services-section" class="nav-link" id="servicesLink">Specialists</a>
                </li>
                <li class="nav-item @(currentController == "Blogs" ? "active" : "")">
                    <a asp-controller="Blogs" asp-action="Index" asp-fragment="services-section" class="nav-link" id="servicesLink">Blog</a>
                </li>
            </ul>
        </div>
       
        <div class="user-menu">
            @if (User.Claims.Count() == 0)
            {
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" id="userDropdown" role="button" data-toggle="dropdown"
                           aria-haspopup="true" aria-expanded="false">
                            <span class="user-icon">
                                <i class="fa-regular fa-user"> Guest</i>
                            </span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right user-dropdown" aria-labelledby="userDropdown">
                            <a class="dropdown-item btn-login" asp-controller="Account" asp-action="Login"
                               style="padding: 10px; transition: background-color 0.3s;"
                               onmouseover="this.style.backgroundColor='#f0f0f0'"
                               onmouseout="this.style.backgroundColor='transparent'">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                            <a class="dropdown-item btn-register" asp-controller="Account" asp-action="Register"
                               style="padding: 10px; transition: background-color 0.3s;"
                               onmouseover="this.style.backgroundColor='#f0f0f0'"
                               onmouseout="this.style.backgroundColor='transparent'">
                                <i class="fas fa-user-plus"></i> Register
                            </a>
                        </div>

                    </li>
                </ul>
            }
            else
            {
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <!-- Nút mở dropdown -->

                            <span class="user-icon d-flex align-items-center">
                                <a href="/Account/Profile" class="d-flex align-items-center" style="text-decoration: none; color: inherit;">
                                    <span class="user-name" style="font-weight: bold; font-size: 14px;">
                                        @User.Claims.FirstOrDefault(x => x.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value
                                    </span>
                                    <img src="@User.Claims.FirstOrDefault(x => x.Type == "Avatar")?.Value"
                                         alt="User Avatar" class="user-logo"
                                         style="width: 35px; height: 35px; border-radius: 50%; margin-left: 15px; object-fit: cover;">
                                </a>
                            </span>
             


                        <!-- Dropdown Menu -->
                        <div class="dropdown-menu dropdown-menu-right user-dropdown" aria-labelledby="userDropdown" style="min-width: 200px;">
                            @if (userRole == "4") // Điều chỉnh Role theo hệ thống của bạn
                            {
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Bookings" asp-action="History"
                                   style="padding: 10px; transition: background-color 0.3s;"
                                   onmouseover="this.style.backgroundColor='#f0f0f0'"
                                   onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="fas fa-calendar-alt mr-2"></i>
                                    <span>My Appointments</span>
                                </a>
                            }
                            @if (userRole == "1") 
                            {
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Services" asp-action="IndexDaboard"
                                   style="padding: 10px; transition: background-color 0.3s;"
                                   onmouseover="this.style.backgroundColor='#f0f0f0'"
                                   onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="fas fa-calendar-alt mr-2"></i>
                                    <span>Manage and Dashboard</span>
                                </a>
                            }
                            @if (userRole == "0")
                            {
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Dashboard" asp-action="Index"
                                   style="padding: 10px; transition: background-color 0.3s;"
                                   onmouseover="this.style.backgroundColor='#f0f0f0'"
                                   onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="fas fa-calendar-alt mr-2"></i>
                                    <span>Manage and Dashboard</span>
                                </a>
                            }
                            @if (userRole == "2" || userRole == "3")
                            {
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Bookings" asp-action="ManageBooking"
                                   style="padding: 10px; transition: background-color 0.3s;"
                                   onmouseover="this.style.backgroundColor='#f0f0f0'"
                                   onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="fas fa-calendar-alt mr-2"></i>
                                    <span>Manage and Dashboard</span>
                                </a>
                            }
                            <!-- Logout Button -->
                            <a asp-controller="Account" asp-action="Logout" class="dropdown-item d-flex align-items-center"
                               style="padding: 10px; transition: background-color 0.3s; cursor: pointer;"
                               onmouseover="this.style.backgroundColor='#f0f0f0'"
                               onmouseout="this.style.backgroundColor='transparent'">
                                <i class="fas fa-sign-out-alt mr-2"></i>
                                <span>Logout</span>
                            </a>
                        </div>
                    </li>
                </ul>

            }
            
        </div>
    </div>
</nav>
