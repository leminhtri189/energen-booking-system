@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Energen</title>
    <link rel="stylesheet" href="~/dashboard/src/assets/css/styles.min.css">
    <link rel="stylesheet" href="~/css/flaticon.css">

    <style>
        .sidebar-item.active {
            background-color: #fffae6 !important; /* Màu vàng nhạt */
            color: #d4af37 !important; /* Màu vàng đậm */
        }

            /* Khi hover vào mục đang active */
            .sidebar-item.active:hover {
                background-color: #f5c9a9 !important; /* Màu da đậm hơn */
                color: #fff !important; /* Chữ trắng */
            }

        /* Khi hover vào mục không active */
        .sidebar-item:hover {
            background-color: #fbe4d5 !important; /* Màu da nhạt hơn */
            color: #000 !important; /* Chữ đen */
        }


    </style>
</head>

<body >
    <!--  Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
         data-sidebar-position="fixed" data-header-position="fixed">
        <!-- Sidebar Start -->

        <aside class="left-sidebar">
            <!-- Sidebar scroll-->
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    <a class="navbar-brand " asp-controller="Dashboard" asp-action="Index">
                        <span class="flaticon-lotus"></span> Energen
                    </a>
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-8"></i>
                    </div>
                </div>
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        <ul id="sidebarnav">
                            <!-- Điều kiện hiển thị menu cho userRole = "0" (User) -->
                            @if (userRole == "0")
                            {
                                <li class="sidebar-item @(currentController?.ToLower() == "dashboard" ? "active" : "")">
                                    <a class="sidebar-link" href="/dashboard">
                                        <span>
                                            <i class="ti ti-dashboard"></i> <!-- Đổi thành đúng icon cho Dashboard -->
                                        </span>
                                        <span class="hide-menu">Dashboard</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(currentController == "Account" ? "active" : "")">
                                    <a class="sidebar-link" href="/account">
                                        <span>
                                            <i class="ti ti-user"></i> <!-- Đổi thành đúng icon cho Account -->
                                        </span>
                                        <span class="hide-menu">Account</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(currentController == "Feedback" ? "active" : "")">
                                    <a class="sidebar-link" href="/feedback">
                                        <span>
                                            <i class="ti ti-message-circle"></i> <!-- Thay đổi thành icon Feedback -->
                                        </span>
                                        <span class="hide-menu">Feedback</span>
                                    </a>
                                </li>
                            }

                            <!-- Điều kiện hiển thị menu cho userRole = "1" (Manager) -->
                            @if (userRole == "1")
                            {
                                <li class="sidebar-item @(currentController?.ToLower() == "services" ? "active" : "")">
                                    <a class="sidebar-link" href="/service">
                                        <span>
                                            <i class="ti ti-briefcase"></i> <!-- Đổi thành đúng icon cho Service -->
                                        </span>
                                        <span class="hide-menu">Service</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(currentController == "Category" ? "active" : "")">
                                    <a class="sidebar-link" href="/category">
                                        <span>
                                            <i class="ti ti-tag"></i> <!-- Đổi thành đúng icon cho Category -->
                                        </span>
                                        <span class="hide-menu">Category</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(currentController == "Blog" ? "active" : "")">
                                    <a class="sidebar-link" href="/blog">
                                        <span>
                                            <i class="ti ti-file-text"></i> <!-- Thay đổi thành icon cho Blog -->
                                        </span>
                                        <span class="hide-menu">Blog</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(currentController == "Question" ? "active" : "")">
                                    <a class="sidebar-link" href="/question">
                                        <span>
                                            <i class="ti ti-question-mark"></i> <!-- Thay đổi thành icon cho Question -->
                                        </span>
                                        <span class="hide-menu">Question</span>
                                    </a>
                                </li>
                            }

                            <!-- Điều kiện hiển thị menu cho userRole = "2" hoặc "3" (Staff, Therapist) -->
                            @if (userRole == "2" || userRole == "3")
                            {
                                <li class="sidebar-item @(currentController?.ToLower() == "bookings" ? "active" : "")">
                                    <a class="sidebar-link" href="/tracking">
                                        <span>
                                            <i class="ti ti-chart-line"></i> <!-- Đổi thành đúng icon cho Tracking -->
                                        </span>
                                        <span class="hide-menu">Tracking</span>
                                    </a>
                                </li>
                            }
                        </ul>

                            </nav>
                            <!-- End Sidebar navigation -->
                        </div>
                        <!-- End Sidebar scroll-->
                    </aside>
                    <!--  Sidebar End -->
                    <!--  Main wrapper -->
                    <div class="body-wrapper">
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                            <li class="nav-item dropdown" style="position: relative;">
                                <span class="user-icon d-flex align-items-center">
                                    <a href="#" class="d-flex align-items-center" style="text-decoration: none; color: inherit; cursor: pointer;" data-toggle="dropdown">
                                        <span class="user-name" style="font-weight: bold; font-size: 14px;">
                                            @User.Claims.FirstOrDefault(x => x.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value
                                        </span>
                                        <img src="@User.Claims.FirstOrDefault(x => x.Type == "Avatar")?.Value"
                                             alt="User Avatar" class="user-logo"
                                             style="width: 35px; height: 35px; border-radius: 50%; margin-left: 15px; object-fit: cover;">
                                    </a>
                                </span>
                                <div class="dropdown-menu dropdown-menu-right user-dropdown" aria-labelledby="userDropdown" style="min-width: 200px; display: none; position: absolute; top: 100%; left: 0; transition: opacity 0.3s ease; opacity: 0;">
                                    <!-- Logout Button -->
                                    <a asp-controller="Account" asp-action="Logout" class="dropdown-item d-flex align-items-center"
                                       style="padding: 10px; transition: background-color 0.3s; cursor: pointer; display: block;"
                                       onmouseover="this.style.backgroundColor='#f0f0f0'"
                                       onmouseout="this.style.backgroundColor='transparent'">
                                        <i class="fas fa-sign-out-alt mr-2"></i>
                                        <span>Logout</span>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
                        <!--  Header End -->
                        <div class="container-fluid">
                            <div id="services-section" class="wrapper" style="display: flex; flex-direction: column; min-height: 100vh;">                      
                                    @RenderBody()


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
    <script src="../wwwroot/dashboard/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="../wwwroot/dashboard/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../wwwroot/dashboard/src/assets/js/sidebarmenu.js"></script>
    <script src="../wwwroot/dashboard/src/assets/js/app.min.js"></script>
    <script src="../wwwroot/dashboard/src/assets/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="../wwwroot/dashboard/src/assets/libs/simplebar/dist/simplebar.js"></script>
    <script src="../wwwroot/dashboard/src/assets/js/dashboard.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Dùng JavaScript để hiển thị dropdown khi hover vào phần tử
        document.querySelector('.nav-item.dropdown').addEventListener('mouseenter', function() {
            var dropdownMenu = this.querySelector('.dropdown-menu');
            dropdownMenu.style.display = 'block';
            dropdownMenu.style.opacity = '1';
        });

        document.querySelector('.nav-item.dropdown').addEventListener('mouseleave', function() {
            var dropdownMenu = this.querySelector('.dropdown-menu');
            dropdownMenu.style.display = 'none';
            dropdownMenu.style.opacity = '0';
        });
    </script>
                @RenderSection("Scripts", required: false)

            </body>

            </html>