@model IEnumerable<Web.Models.ServicesViewModel>

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Our Service</h2>
    <form method="get" asp-controller="Services" asp-action="Index" asp-fragment="services-section" class="mb-4">
        <div class="row">
            <div class="col-md-4">
                <input type="text" name="searchKey" class="form-control" placeholder="Enter Service Name..." value="@Context.Request.Query["searchKey"]">
            </div>

            <!-- Dropdown Category -->
            <div class="col-md-3">
                <select name="categoryId" class="form-control">
                    <option value="">-- Select Category --</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Value" selected="@(category.Value == Context.Request.Query["categoryId"] ? "selected" : null)">
                            @category.Text
                        </option>
                    }
                </select>
            </div>

            <!-- Dropdown Skin Type -->
            <div class="col-md-3">
                <select name="skinTypeId" class="form-control">
                    <option value="">-- Select Skin Type --</option>
                    @foreach (var skinType in ViewBag.SkinTypes)
                    {
                        <option value="@skinType.Value" selected="@(skinType.Value == Context.Request.Query["skinTypeId"] ? "selected" : null)">
                            @skinType.Text
                        </option>
                    }
                </select>
            </div>

            <!-- Nút tìm kiếm -->
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var service in Model)
        {
            <div class="col-md-3">
                <!-- Cột chiếm 1/4 chiều rộng trên màn hình lớn -->
                <div class="card shadow-sm border-0 rounded-lg">
                    <img src="@service.Thumbnail" class="card-img-top" alt="@service.ServiceName">
                    <div class="card-body">
                        <h5 class="card-title">@service.ServiceName</h5>
                        <p class="card-text text-muted">@service.Description</p>
                        <p><strong>Thời gian:</strong> @service.Duration phút</p>
                        <p><strong>Giá:</strong> @string.Format("{0:N0}", service.Price) VND</p>
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Services" asp-action="Details" asp-fragment="services-section" asp-route-id="@service.Id" class="btn btn-outline-primary btn-sm">Details</a>
                            <a asp-controller="Bookings" asp-action="Index" asp-fragment="services-section" asp-route-id="@service.Id" class="btn btn-primary btn-sm">Booking Now</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Phân trang -->
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Services" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-fragment="services-section">Pre</a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Services" asp-action="Index" asp-route-page="@i" asp-fragment="services-section">@i</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Services" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-fragment="services-section">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>

<style>
    .card {
        border-radius: 15px; /* Bo tròn các góc của card */
        transition: transform 0.3s ease-in-out; /* Hiệu ứng zoom khi hover */
        overflow: hidden;
        background-color: #f9f9f9;
    }

        .card:hover {
            transform: translateY(-10px) scale(1.05); /* Khi hover sẽ nổi lên và phóng to nhẹ */
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1); /* Tạo bóng đổ khi hover */
        }

    .card-img-top {
        height: 200px; /* Đảm bảo hình ảnh không bị quá to */
        object-fit: cover;
    }

    .card-body {
        padding: 1.25rem; /* Padding dễ chịu và rộng rãi hơn */
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: bold;
    }

    .card-text {
        font-size: 0.95rem;
        color: #666;
    }

    .pagination .page-item.active .page-link {
        background-color: #007bff;
        border-color: #007bff;
        color: white;
    }

    .pagination .page-link {
        color: #007bff;
    }

        .pagination .page-link:hover {
            color: #0056b3;
        }

    .pagination {
        margin-top: 20px;
    }
</style>
