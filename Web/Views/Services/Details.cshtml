@model BusinessObject.Entities.Service

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="container mt-5">
    <div class="details-container">
        <h2 class="text-center text-primary">Service Details</h2>
        <hr>

        <!-- Phần 1 + Phần 2: Thumbnail + Thông tin dịch vụ -->
        <div class="row">
            <!-- Phần 1: Hình ảnh chính -->
            <div class="col-md-6">
                <img src="@Model.Thumbnail" alt="Service Image" class="service-thumbnail">
            </div>

            <!-- Phần 2: Thông tin dịch vụ -->
            <div class="col-md-6">
                <h3 class="service-title">@Model.ServiceName</h3>
                <p><strong>Duration:</strong> @Model.Duration minutes</p>
                <p><strong>Price:</strong> @string.Format("{0:N0}", Model.Price) VND</p>
                <p class="category"><strong>Category:</strong> @Model.ServiceCategoryNavigation?.Name</p>
                <p class="skin-type"><strong>Skin Types:</strong> @string.Join(", ", Model.SkinTypes.Select(st => st.Name))</p>

                <!-- ⭐ Hiển thị Rating Trung Bình -->
     @*            <p>
                    <strong>Rating:</strong>
                    <span class="rating">@Html.Raw(GetStarRating(Model.AverageRating))</span>
                    (@Model.AverageRating.ToString("0.0")/5)
                </p> *@

                <!-- Action Buttons -->
                <div style="display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 20px;">
                    <a asp-controller="Bookings" asp-action="Index" asp-route-id="@Model.Id"
                       style="background-color: #d4af37; color: white; border-radius: 8px; padding: 12px 24px; font-size: 16px; font-weight: bold; text-transform: uppercase; text-decoration: none; display: inline-block;">
                        Booking Now
                    </a>

                    <a asp-controller="Chat" asp-action="Advisory" asp-route-serviceId="@Model.Id"
                       style="background-color: #28a745; color: white; border-radius: 8px; padding: 12px 24px; font-size: 16px; font-weight: bold; text-transform: uppercase; text-decoration: none; display: inline-block;">
                        Advise
                    </a>
                </div>


            </div>
        </div>

        <!-- Phần 3: Danh sách ảnh + Mô tả -->
        <div class="mt-4">
            <h4>Gallery</h4>
            <div class="image-gallery">
                @foreach (var image in Model.ServiceImageNavigation.Take(6))
                {
                    <img src="@image.ImageUrl" alt="Additional Image" class="additional-image">
                }
            </div>

            <!-- Mô tả dịch vụ -->
            <div class="service-description mt-3">
                <h5>Description</h5>
                <p>@Model.Description</p>
            </div>
        </div>

        <!-- ⭐ Phần 4: Feedback & Rating -->
        <div class="feedback-container mt-5">
            <h4>Customer Reviews</h4>

            <!-- Hiển thị danh sách feedback -->
           @*  @if (Model.Feedbacks != null && Model.Feedbacks.Any())
            {
                <div class="feedback-list">
                    @foreach (var feedback in Model.Feedbacks)
                    {
                        <div class="feedback-item">
                            <p>
                                <strong>@feedback.UserName</strong> -
                                <span class="rating">@Html.Raw(GetStarRating(feedback.Rating))</span>
                                (@feedback.Rating.ToString("0.0")/5)
                            </p>
                            <p>@feedback.Comment</p>
                            <small class="text-muted">@feedback.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    }
                </div>
            } *@
            else
            {
                <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
            }
        </div>
    </div>
</div>

<style>
    .details-container {
        max-width: 1200px;
        margin: auto;
        padding: 30px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    /* Hình ảnh chính */
    .service-thumbnail {
        width: 100%;
        height: auto;
        border-radius: 10px;
        object-fit: cover;
        max-height: 350px;
    }

    /* Danh sách ảnh */
    .image-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .additional-image {
        width: calc(100% / 6 - 10px); /* 6 ảnh trên 1 hàng */
        height: 100px;
        border-radius: 10px;
        object-fit: cover;
    }

    /* Rating */
    .rating {
        color: #f39c12;
        font-size: 1.2rem;
    }

    /* Feedback */
    .feedback-container {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 2px solid #ddd;
    }

    .feedback-item {
        border-left: 4px solid #007bff;
        padding-left: 20px;
        margin-bottom: 15px;
    }

        .feedback-item small {
            color: gray;
        }
</style>
