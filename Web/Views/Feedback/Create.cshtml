@model Web.Models.Feedback.BookingFeedbackViewModel
@{
    Layout = null;
    ViewData["Title"] = "Feedback";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Star rating styles */
        .rating {
          direction: rtl;
          unicode-bidi: bidi-override;
          display: inline-block;
        }
        .rating input {
          display: none;
        }
        .rating label {
          font-size: 2rem;
          color: #ddd;
          cursor: pointer;
          transition: color 0.2s;
        }
        /* Change color on hover and when selected */
        .rating input:checked ~ label,
        .rating label:hover,
        .rating label:hover ~ label {
          color: #FFC107;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <a href="/Booking/History?id=@ViewData["booking_id"]" class="navbar-brand">Back</a>
            </div>
        </nav>
    </header>
    <main>
        <div class="container py-5">
            <h2 class="mb-4 text-center">Service Feedback Form</h2>
            <form method="post" asp-action="PostFeedback">
                <input type="hidden" asp-for="BookingId" value="@ViewData["booking_id"]"/>
                <!-- Therapist Rating -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Therapist Rating</label><br>
                    <div class="rating">
                        <input type="radio" id="therapist_star5" name="TherapistRating" asp-for=TherapistRating value="5">
                        <label for="therapist_star5" title="5 stars">&#9733;</label>
                        <input type="radio" id="therapist_star4" name="TherapistRating" asp-for=TherapistRating value="4">
                        <label for="therapist_star4" title="4 stars">&#9733;</label>
                        <input type="radio" id="therapist_star3" name="TherapistRating" asp-for=TherapistRating value="3">
                        <label for="therapist_star3" title="3 stars">&#9733;</label>
                        <input type="radio" id="therapist_star2" name="TherapistRating" asp-for=TherapistRating value="2">
                        <label for="therapist_star2" title="2 stars">&#9733;</label>
                        <input type="radio" id="therapist_star1" name="TherapistRating" asp-for=TherapistRating value="1">
                        <label for="therapist_star1" title="1 star">&#9733;</label>
                    </div>
                </div>

                <!-- Service Rating -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Service Rating</label><br>
                    <div class="rating">
                        <input type="radio" id="service_star5" name="service_rating" asp-for=ServiceRating value="5">
                        <label for="service_star5" title="5 stars">&#9733;</label>
                        <input type="radio" id="service_star4" name="service_rating" asp-for=ServiceRating value="4">
                        <label for="service_star4" title="4 stars">&#9733;</label>
                        <input type="radio" id="service_star3" name="service_rating" asp-for=ServiceRating value ="3">
                        <label for="service_star3" title="3 stars">&#9733;</label>
                        <input type="radio" id="service_star2" name="service_rating" asp-for=ServiceRating value ="2">
                        <label for="service_star2" title="2 stars">&#9733;</label>
                        <input type="radio" id="service_star1" name="service_rating" asp-for=ServiceRating value="1">
                        <label for="service_star1" title="1 star">&#9733;</label>
                    </div>
                </div>

                <!-- Therapist Feedback -->
                <div class="mb-4">
                    <label for="TherapistFeedback" class="form-label fw-bold">Therapist Feedback</label>
                    <textarea class="form-control" id="TherapistFeedback" name="TherapistFeedback" asp-for=TherapistFeedback rows="3" placeholder="Share your feedback about your therapist"></textarea>
                </div>

                <!-- Service Feedback -->
                <div class="mb-4">
                    <label for="ServiceFeedback" class="form-label fw-bold">Service Feedback</label>
                    <textarea class="form-control" id="ServiceFeedback" name="ServiceFeedback" asp-for=ServiceFeedback rows="3" placeholder="Share your feedback about the service"></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Submit Feedback</button>
                </div>
            </form>
        </div>
    </main>

    <!-- Bootstrap JS (optional, for interactivity) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
