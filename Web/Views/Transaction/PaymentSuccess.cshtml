@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div style="max-width: 600px; margin: 100px auto; text-align: center; padding: 30px; border-radius: 15px; background: #fff; box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1); border: 1px solid #eee;">
    <div style="color: #C9A86A; font-size: 50px;">✨</div>
    <h2 style="color: #222; font-family: 'Times New Roman', serif; font-size: 28px; margin-bottom: 15px;">
        PAYMENT SUCCESSFUL
    </h2>
    <p style="font-size: 16px; color: #555; margin-bottom: 25px;">
        Your payment has been processed successfully. Thank you for choosing our service!
    </p>

    <div style="margin-top: 20px;">
        <a asp-controller="Home" asp-action="Index" 
           style="display: inline-block; padding: 12px 25px; background-color: #C9A86A; color: #fff; text-decoration: none; font-weight: bold; border-radius: 5px; margin-right: 10px;">
            Home Page
        </a>
        <a asp-controller="Bookings" asp-action="History" 
           style="display: inline-block; padding: 12px 25px; border: 2px solid #C9A86A; color: #C9A86A; text-decoration: none; font-weight: bold; border-radius: 5px;">
            View Appointment
        </a>
    </div>
</div>
