@model BusinessObject.Entities.Service

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<style>
    .therapist-card.selected-therapist {
        border: 3px solid #0d6efd !important;
        background-color: #e7f1ff !important;
        box-shadow: 0 0 10px rgba(13, 110, 253, 0.5);
    }

    .select-btn.selected {
        background-color: #198754 !important;
        border-color: #198754 !important;
    }

    .day.active {
        background-color: #4caf50 !important;
        color: white !important;
        border: 2px solid #388e3c !important;
        box-shadow: 0 0 10px rgba(76, 175, 80, 0.5);
        position: relative;
    }

        .day.active::after {
            content: "✓";
            position: absolute;
            top: 5px;
            right: 8px;
            font-size: 14px;
            color: white;
            background-color: #2e7d32;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .time-slot.disabled {
        background-color: #e0e0e0; /* màu xám nhạt */
        color: #999; /* chữ mờ hơn */
        cursor: not-allowed;
        opacity: 0.6; /* làm mờ tổng thể */
        pointer-events: none; /* không cho click */
    }

    .time-slot {
        transition: background-color 0.3s, color 0.3s;
    }

        .time-slot:not(.disabled):hover {
            background-color: #d0f0ff;
            color: #000;
            cursor: pointer;
        }
</style>


<input type="hidden" id="serviceId" value="@Model.Id" />
<div class="container">
    <div style="display: flex; justify-content: center; padding: 40px 20px; background-color: #fff;">
        <div style="max-width: 700px; width: 100%; text-align: center; border: 1px solid #eee; padding: 30px; border-radius: 10px; box-shadow: 0px 8px 30px rgba(0, 0, 0, 0.05);">
            <!-- Tên dịch vụ -->
            <h2 style="font-size: 28px; font-weight: 600; letter-spacing: 2px; color: #000; margin-bottom: 10px;" class="text-center">
                @Model.ServiceName.ToUpper()
            </h2>

            <div style="width: 80px; height: 2px; background-color: #d4af37; margin: 10px auto 20px;"></div>    
            <div style="margin-bottom: 30px;">
                <img src="@Model.Thumbnail" alt="Service Image" style="max-width: 100%; height: auto; border-radius: 1px; border: 1px solid #d4af37;">
            </div>

            <div style="display: flex; align-items: center; justify-content: center; gap: 20px;">
                <span style="color: #d4af37; font-size: 20px; font-weight: bold;">Duration: @Model.Duration min</span>
                <span style="color: #d4af37; font-size: 20px; font-weight: bold;">Price: $@Model.Price</span>

                <a asp-controller="Services" asp-action="Details" asp-fragment="services-section" asp-route-id="@Model.Id "style="display: inline-block; padding: 7px 14px; border: 1px solid #d4af37; color: #d4af37; border-radius: 1px; text-decoration: none; transition: 0.3s;"
                   onmouseover="this.style.backgroundColor='#d4af37'; this.style.color='#fff';"
                   onmouseout="this.style.backgroundColor='transparent'; this.style.color='#d4af37';">
                    Detail
                </a>
            </div>
        </div>
    </div>

    <h3 class="text-center">Select Therapist</h3>

    <!-- Button: Auto Select Therapist -->
    <div class="text-end mb-3">
        <button id="autoSelectBtn" class="btn btn-warning text-center">Please select a therapist for me</button>
    </div>
        <div id="therapistContainer">
        </div>
    <p id="select-therapist-msg" class="text-center text-danger">
        Please select therapist to select date and time.
    </p>

    <!-- Tiêu đề "Chọn ngày giờ" ban đầu ẩn -->
    <h3 id="choose-date-title" style="display: none;">Select Date and Time</h3>

    <div class="calendar" id="calendar-container" style="display: none;">
        <div class="calendar-header text-center">
            <button id="prev-week" onclick="prevWeek()">❮</button>
            <span id="week-label"></span>
            <button id="next-week" onclick="nextWeek()">❯</button>
        </div>
        <div id="days-container" style="width: 100%; display: flex; justify-content: center; align-items: center;margin: 20px 0;
">
            <div id="days"></div>
        </div>

        <h4 id="morning-title" class="text-center" style="display: none;">Morning</h4>
        <div class="row text-center" id="morning-slots" ></div>

        <h4 id="afternoon-title" style="display: none;" class="text-center">Afternoon</h4>
        <div class="row text-center" id="afternoon-slots" ></div>
    </div>

</div>
<div style="display: flex; justify-content: flex-end; padding: 20px; margin:20px">
    <button id="btnPayment" class="btn btn-primary btn-sm px-3 py-3"
            style="display: none; align-self: center;"
            onclick="payment()">
        Payment for services
    </button>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
        let selectedChuyenVienId = null;
    let selectedDate = null;
    let selectedTime = null;
    let currentWeekStart = new Date(); // Biến toàn cục
    let today = new Date(); // Biến toàn cục

    today.setHours(0, 0, 0, 0); // Đặt giờ về 0 để tránh lỗi so sánh ngày

    document.addEventListener("DOMContentLoaded", function () {
        // Cập nhật ngày bắt đầu tuần
        currentWeekStart.setDate(currentWeekStart.getDate() - currentWeekStart.getDay() + 1); // Set ngày bắt đầu tuần là thứ 2
        today.setHours(0, 0, 0, 0);

        function disableCalendar() {
            document.getElementById("calendar-container").style.display = "none";
            document.getElementById("days").innerHTML = '<p>Vui lòng chọn chuyên viên để xem lịch</p>';
            document.getElementById("morning-slots").innerHTML = '';
            document.getElementById("afternoon-slots").innerHTML = '';
            document.getElementById("morning-title").style.display = "none";
            document.getElementById("afternoon-title").style.display = "none";
        }

        disableCalendar();

        function selectTherapist(chuyenVienId) {
            selectedChuyenVienId = chuyenVienId;
            document.getElementById("calendar-container").style.display = "block";
            $("#select-therapist-msg").hide();
            loadCalendar();
            document.querySelectorAll('.therapist-card').forEach(card => {
            card.classList.remove('selected-therapist');
        });

        document.querySelectorAll('.select-btn').forEach(btn => {
            btn.textContent = 'Select';
            btn.classList.remove('selected');
        });

        // Đánh dấu therapist được chọn
        const selectedCard = document.querySelector(`.therapist-card[data-therapist-id="${chuyenVienId}"]`);
        const selectedBtn = document.querySelector(`.select-btn[data-therapist-id="${chuyenVienId}"]`);

        if (selectedCard) {
            selectedCard.classList.add('selected-therapist');
        }

        if (selectedBtn) {
            selectedBtn.textContent = 'Selected';
            selectedBtn.classList.add('selected');
        }
        }

        function loadCalendar() {
            let endDate = new Date();
            endDate.setDate(today.getDate() + 30);
            let weekEnd = new Date(currentWeekStart);
            weekEnd.setDate(currentWeekStart.getDate() + 6);
            weekEnd = weekEnd > endDate ? endDate : weekEnd;

            document.getElementById("week-label").textContent = `Week from ${currentWeekStart.toLocaleDateString('vi-VN')} to ${weekEnd.toLocaleDateString('vi-VN')}`;

            let daysHtmlContent = '';
            let tempDate = new Date(currentWeekStart);

            while (tempDate <= weekEnd) {
                const dayOfWeek = tempDate.getDay();
                if (dayOfWeek !== 6 && dayOfWeek !== 0) { // Bỏ qua thứ 7 và chủ nhật
                    let formattedDate = tempDate.toISOString().split('T')[0];
                    let isPast = tempDate < today;
                    let isSelected = formattedDate === selectedDate;
                        daysHtmlContent += `
        <div class="day ${isSelected ? 'active' : ''}" style="
            width: 60px; height: 80px;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            text-align: center;
            font-size: 14px;
            background: white;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            ${isPast ? 'color: gray; cursor: not-allowed;' : 'cursor: pointer;'}
        " onclick="${!isPast ? `selectDate('${formattedDate}', event)` : ''}">
            <span style="font-weight: bold;">${tempDate.getDate()}</span>
            <span style="font-size: 12px;">${tempDate.toLocaleDateString('en-US', { weekday: 'short' })}</span>
        </div>
    `;


                }
                tempDate.setDate(tempDate.getDate()+1);
            }

                document.getElementById("days").innerHTML = `
        <div style="display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap;">
            ${daysHtmlContent}
        </div>
    `;


            if (selectedDate) {
                loadTimeSlots(selectedDate);
            }
        }

        function selectDate(date, event) {
            selectedDate = date;
            document.getElementById("morning-title").style.display = "block";
            document.getElementById("afternoon-title").style.display = "block";
            document.querySelectorAll(".day").forEach(el => el.classList.remove("active"));
            event.target.classList.add("active");
            loadTimeSlots(date);
        }

        function loadTimeSlots(date) {
            let morningHtml = '';
            let afternoonHtml = '';
            const timeSlots = [
                "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "11:30",
                "13:00", "13:30", "14:00", "14:30", "15:00", "15:30", "16:00", "16:30"
            ];

            // Khởi tạo các khung giờ cho buổi sáng và chiều
            timeSlots.forEach(slot => {
                const slotHtml = `<div class="col-md-2 time-slot disabled" style="width: 70px; margin: 5px; text-align: center; padding: 5px;
                                  border-radius: 5px; background-color: #f0f0f0; cursor: pointer;">
                                  ${slot}</div>`;
                slot.split(":")[0] < 12 ? morningHtml += slotHtml : afternoonHtml += slotHtml;
            });

            document.getElementById("morning-slots").innerHTML = morningHtml;
            document.getElementById("afternoon-slots").innerHTML = afternoonHtml;

            if (!selectedChuyenVienId) return;
            console.log("đáasda",date);
            $.ajax({
                url: '/Bookings/GetAvailableTimeSlots',
                method: 'GET',
                data: { therapistid: selectedChuyenVienId, date: date },
                success: function (response) {
                    if (!response.success) {
                        alert(response.message);
                        return;
                    }

                    let availableSlots = response.data.result;
                    document.querySelectorAll(".time-slot").forEach(slot => {
                        let time = slot.innerText.trim() + ":00";
                        if (availableSlots[time] === true) {
                            slot.classList.remove("disabled");
                            slot.addEventListener("click", function () {
                                selectedTime = this.innerText.trim();
                                selectTimeSlot(this);
                            });
                        }
                    });
                },
                error: function () {
                    alert("Không thể tải lịch. Vui lòng thử lại.");
                }
            });
        }

        function selectTimeSlot(slot) {
            document.querySelectorAll(".time-slot").forEach(s => {
                s.style.backgroundColor = ''; // Xóa màu nền
                s.style.color = ''; // Xóa màu chữ
            });

            slot.style.backgroundColor = '#4caf50'; // Màu nền khi chọn
            slot.style.color = 'white'; // Màu chữ khi chọn

            selectedTime = slot.innerText.trim();
            $("#btnPayment").show(); // Hiển thị nút thanh toán
        }

        function payment() {
            let form = document.createElement("form");
            form.method = "POST";
            form.action = "/Bookings/BookingService";
            form.style.display = "none";

            function createHiddenInput(name, value) {
                let input = document.createElement("input");
                input.type = "hidden";
                input.name = name;
                input.value = value;
                return input;
            }

            form.appendChild(createHiddenInput("ServiceId", document.getElementById("serviceId").value));
            form.appendChild(createHiddenInput("TherapistId", selectedChuyenVienId));
            form.appendChild(createHiddenInput("SelectedDate", selectedDate));
            form.appendChild(createHiddenInput("SelectedTime", selectedTime));

            document.body.appendChild(form);
            form.submit();
        }

        window.selectTherapist = selectTherapist;
        window.selectDate = selectDate;
        window.payment = payment;
        window.loadCalendar = loadCalendar;

        // Gọi loadCalendar ngay khi trang tải lần đầu
        loadCalendar();
    });

</script>
<script>
        function prevWeek() {
        let newStart = new Date(currentWeekStart);
        newStart.setDate(currentWeekStart.getDate() - 7);

        if (newStart >= today) {
            currentWeekStart = newStart;
            loadCalendar();
        } else {
            alert("Không thể quay lại tuần trước!");
        }
    }

    function nextWeek() {
        let newStart = new Date(currentWeekStart);
        newStart.setDate(currentWeekStart.getDate() + 7);

        let maxDate = new Date();
        maxDate.setDate(today.getDate() + 30);

        if (newStart <= maxDate) {
            currentWeekStart = newStart;
            loadCalendar();
        } else {
            alert("Không thể chọn tuần xa hơn!");
        }
    }
        window.prevWeek = prevWeek;
    window.nextWeek = nextWeek
</script>
<script>

        let currentPage = 1;

        // Hàm tải các therapist từ server
        function loadTherapists(page) {

            $.ajax({
                url: `/Bookings/GetTherapistsToBooking?page=${page}`,
                type: "GET",
                beforeSend: function () {
                    $("#therapistContainer").html("<p class='text-center'>Loading...</p>");
                },
                success: function (data) {
                    if (!data.trim()) {
                        $("#therapistContainer").html("<p class='text-center'>No therapists available.</p>");
                    } else {
                        $("#therapistContainer").html(data);
                        currentPage = page;

                    }
                },
                error: function () {
                    $("#therapistContainer").html("<p class='text-center text-danger'>Error loading therapists.</p>");
                }
            });
        }
            function changePage(direction) {
        console.log(`Changing page by: ${direction}`); // Kiểm tra sự thay đổi trang
        loadTherapists(currentPage + direction);
    }
        


        // Xử lý khi người dùng click vào nút "autoSelectBtn"
        $("#autoSelectBtn").click(function () {
            // Chuyển đổi trạng thái nút thanh toán
            $("#btnPayment").show();
            $("#autoSelectBtn").hide();
            $("#therapistContainer").html(`
                <div class="alert alert-info text-center">
                    The system has arranged a specialist for you!
                </div>
            `);
        });

        $(document).ready(function () {
            loadTherapists(1);
        });



</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const therapistButtons = document.querySelectorAll(".therapist-select-btn"); // Nút chọn therapist
        const calendarContainer = document.getElementById("calendar-container");

        // Ẩn lịch ban đầu
        calendarContainer.style.display = "none";

        therapistButtons.forEach(button => {
            button.addEventListener("click", function () {
                // Khi người dùng chọn therapist
                calendarContainer.style.display = "block";
            });
        });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


