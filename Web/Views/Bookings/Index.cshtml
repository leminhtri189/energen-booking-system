@model BookingViewModel

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    var today = DateTime.Now;
    var maxDate = today.AddMonths(1);
}

<style>
    .chuyen-vien-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        margin: 10px;
        text-align: center;
        height: 100%;
    }

        .chuyen-vien-card img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
        }

    .carousel-control-prev, .carousel-control-next {
        width: 5%;
    }

    .calendar {
        margin-top: 20px;
    }

        .calendar .day {
            padding: 10px;
            margin: 5px;
            border: 1px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
            width: 80px;
        }

            .calendar .day.active {
                background-color: #007bff;
                color: white;
            }

        .calendar .time-slot {
            padding: 10px;
            margin: 5px;
            border: 1px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
            width: 80px;
        }

            .calendar .time-slot.disabled {
                background-color: #f0f0f0;
                cursor: not-allowed;
            }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
</style>

<input type="hidden" id="serviceId" value="@Model.Service.Id" />
<div class="container">
    <div class="card shadow-sm p-3 mb-4 bg-white rounded">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <img src="@Model.Service.Thumbnail" alt="Service Image" class="rounded-circle me-3" width="80" height="80">
                <div>
                    <h4 class="card-title">@Model.Service.ServiceName</h4>
                    <p class="text-muted">Giá: <strong>@Model.Service.Price VND</strong></p>
                    <a href="#" class="btn btn-primary btn-sm">Xem chi tiết</a>
                </div>
            </div>
        </div>
    </div>


    <h3>Chọn chuyên viên</h3>
    <div id="therapistCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{
                var therapists = Model.Therapists.ToList();
                int pageSize = 4;
                int totalItems = therapists.Count;
                int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

                for (int i = 0; i < totalPages; i++)
                {
                    var itemsInPage = therapists.Skip(i * pageSize).Take(pageSize).ToList();
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="row">
                            @foreach (var chuyenVien in itemsInPage)
                            {
                                <div class="col-md-3">
                                    <div class="chuyen-vien-card">
                                        <img src="https://image.phunuonline.com.vn/fckeditor/upload/2025/20250204/images/natrakyxao.jpg_271738684013.jpg" alt="@chuyenVien.UserNavigation" />
                                        <h5>@chuyenVien.UserNavigation.FullName</h5>
                                        <p>@chuyenVien</p>
                                        <p>
                                            <span class="text-warning">★</span> @chuyenVien (@chuyenVien)
                                        </p>
                                        <button class="btn btn-success" onclick="chonChuyenVien('@chuyenVien.Id')">Chọn chuyên viên</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        @if (totalPages > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#therapistCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#therapistCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>

    <h3>Chọn ngày giờ</h3>
    <div class="calendar" id="calendar-container" style="display: none;">
        <div class="calendar-header">
            <button id="prev-week" onclick="prevWeek()">❮</button>
            <span id="week-label"></span>
            <button id="next-week" onclick="nextWeek()">❯</button>
        </div>
        <div class="row" id="days"></div>

        <h4 id="morning-title" style="display: none;">Buổi sáng</h4>
        <div class="row" id="morning-slots"></div>

        <h4 id="afternoon-title" style="display: none;">Buổi chiều</h4>
        <div class="row" id="afternoon-slots"></div>
    </div>

</div>
<button id="btnThanhToan" class="btn btn-primary mt-3" onclick="thanhToan()">Thanh toán</button>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let selectedChuyenVienId = null;
        let selectedDate = null;
        let selectedTime = null;
        let currentWeekStart = new Date();

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        while (currentWeekStart < today || currentWeekStart.getDay() === 6 || currentWeekStart.getDay() === 0) {
            currentWeekStart.setDate(currentWeekStart.getDate() + 1);
        }

        function disableCalendar() {
            document.getElementById("calendar-container").style.display = "none";
            document.getElementById("days").innerHTML = '<p>Vui lòng chọn chuyên viên để xem lịch</p>';
            document.getElementById("morning-slots").innerHTML = '';
            document.getElementById("afternoon-slots").innerHTML = '';
            document.getElementById("morning-title").style.display = "none";
            document.getElementById("afternoon-title").style.display = "none";
        }

        disableCalendar();

        function chonChuyenVien(chuyenVienId) {
            selectedChuyenVienId = chuyenVienId;
            document.getElementById("calendar-container").style.display = "block";
            document.getElementById("morning-title").style.display = "block";
            document.getElementById("afternoon-title").style.display = "block";

            let now = new Date();
            let formattedDate = now.toLocaleDateString('vi-VN', { weekday: 'long', day: 'numeric', month: 'long' });
            let formattedTime = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            document.getElementById("week-label").textContent = `${formattedDate}, ${formattedTime}`;

            loadCalendar();
        }

        function loadCalendar() {
            let endDate = new Date();
            endDate.setDate(today.getDate() + 30);

            let weekEnd = new Date(currentWeekStart);
            weekEnd.setDate(currentWeekStart.getDate() + 6);
            weekEnd = weekEnd > endDate ? endDate : weekEnd;

            document.getElementById("week-label").textContent = `Tuần từ ${currentWeekStart.toLocaleDateString('vi-VN')}`;

            let daysHtml = '';
            let tempDate = new Date(currentWeekStart);
            while (tempDate <= weekEnd) {
                if (tempDate.getDay() !== 6 && tempDate.getDay() !== 0) {
                    let formattedDate = tempDate.toISOString().split('T')[0];
                    let isPast = tempDate < today;
                    let isSelected = formattedDate === selectedDate;

                    daysHtml += `<div class="col-md-1 day ${isSelected ? 'active' : ''} ${isPast ? 'disabled' : ''}"
                                 onclick="${!isPast ? `selectDate('${formattedDate}')` : ''}">
                                    ${tempDate.toLocaleDateString('vi-VN', { weekday: 'long', day: 'numeric' })}
                                </div>`;
                }
                tempDate.setDate(tempDate.getDate() + 1);
            }
            document.getElementById("days").innerHTML = daysHtml;

            if (selectedDate) {
                loadTimeSlots(selectedDate);
            }
        }

        function selectDate(date) {
            selectedDate = date;
            document.querySelectorAll(".day").forEach(el => el.classList.remove("active"));
            event.target.classList.add("active");
            loadTimeSlots(date);
        }

        function loadTimeSlots(date) {
            let morningHtml = '';
            let afternoonHtml = '';
            const timeSlots = [
                "08:00", "08:30", "09:00", "09:30", "10:00", "10:30", "11:00", "11:30",
                "13:00", "13:30", "14:00", "14:30", "15:00", "15:30", "16:00", "16:30"
            ];

            timeSlots.forEach(slot => {
                const slotHtml = `<div class="col-md-2 time-slot disabled">${slot}</div>`;
                slot.split(":")[0] < 12 ? morningHtml += slotHtml : afternoonHtml += slotHtml;
            });

            document.getElementById("morning-slots").innerHTML = morningHtml;
            document.getElementById("afternoon-slots").innerHTML = afternoonHtml;

            if (!selectedChuyenVienId) return;

            $.ajax({
                url: '/Bookings/GetAvailableTimeSlots',
                method: 'GET',
                data: { therapistid: selectedChuyenVienId, date: date },
                   success: function (response) {
        if (!response.success) {
            alert(response.message);
            return;
        }

        console.log('response: ', response);

        // Lấy danh sách kết quả từ response.data.result
        let availableSlots = response.data.result;
        console.log("slot",availableSlots);
        document.querySelectorAll(".time-slot").forEach(slot => {
            let time = slot.innerText.trim();


             let formattedTime = time + ":00";

        if (availableSlots[formattedTime] === true) {
            slot.classList.remove("disabled");
        }
        });

        // Thêm sự kiện click cho các time-slot
        document.querySelectorAll(".time-slot").forEach(slot => {
            slot.addEventListener("click", function() {
                chonGio(this.innerText.trim());
            });
        });
    },
    error: function () {
        alert("Không thể tải lịch. Vui lòng thử lại.");
    }

            });
        }
            function chonGio(time) {
        let slots = document.querySelectorAll(".time-slot");

        slots.forEach(slot => {
            if (slot.innerText.trim() === time) {
                if (slot.classList.contains("disabled")) return; // Không chọn nếu bị vô hiệu hóa

                slots.forEach(s => s.classList.remove("selected")); // Xóa trạng thái chọn trước đó
                slot.classList.add("selected"); // Đánh dấu khung giờ đã chọn

                selectedTime = time; // Lưu thời gian đã chọn
                console.log("Giờ đã chọn:", selectedTime);
            }
        });
    }

        function thanhToan() {
            if ( !selectedDate ) {
                alert("Vui lòng chọn đầy đủ chuyên viên, ngày và giờ trước khi thanh toán!");
                return;
            }

            let serviceId = document.getElementById("serviceId").value;
            let bookingData = {
                serviceId: serviceId,
                therapistId: selectedChuyenVienId,
                selectedDate: selectedDate,
                selectedTime: selectedTime
            };
            console.log("bookingData",bookingData);
            $.ajax({
                url: '/Bookings/BookingService',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(bookingData),
                success: function (response) {
        window.location.href = response.redirectUrl;
    },
    error: function (xhr) {
        alert("Lỗi khi thanh toán: " + xhr.responseText);
    }
            });
        }

        window.chonChuyenVien = chonChuyenVien;
        window.selectDate = selectDate;
        window.thanhToan = thanhToan;
    });

</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


