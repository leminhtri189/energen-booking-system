@using DataAccessLayer.Commons
@model PaginationResult<BusinessObject.Entities.Therapist>
<div id="therapistContainer" data-total-pages="@Model.TotalPage" style="position: relative; padding: 20px 0;">
    <div id="therapistCarousel" class="carousel slide" data-bs-ride="false">
        <div class="carousel-inner">
            @foreach (var page in Model.PageContent.Chunk(4)) // Chia therapists thành nhóm 4 người
            {
                <div class="carousel-item @(page.First() == Model.PageContent.First() ? "active" : "")">
                    <div class="row justify-content-center">
                        @foreach (var therapist in page)
                        {
                            <div class="col-md-3">
                                <div class="therapist-card text-center p-3 shadow-sm rounded">
                                    <!-- Ảnh therapist -->
                                    <img src="@therapist.UserNavigation.Avatar"
                                         class="img-fluid rounded-circle mb-2"
                                         width="80" height="80"
                                         style="object-fit: cover; border: 2px solid #ddd;">

                                    <h5 class="fw-bold">@therapist.UserNavigation.FullName</h5>
                                    <p class="text-muted">Experience: @therapist.ExperienceYears years</p>

                                    <p class="bio-text text-truncate"
                                       style="display: -webkit-box;
          -webkit-line-clamp: 3; 
          -webkit-box-orient: vertical;
          overflow: hidden; 
          text-overflow: ellipsis; 
          height: 4.5em; 
          line-height: 1.5em;">
                                        <!-- Cân chỉnh line-height -->
                                        @therapist.Biography
                                    </p>


                                    <div class="d-flex justify-content-between">
                                        <a asp-controller="Therapists" asp-action="Details" asp-route-therapist_id="@therapist.Id"
                                           class="btn btn-outline-primary btn-sm px-2 py-2">Details</a>
                                        <button onclick="selectTherapist('@therapist.Id')"
                                                class="btn btn-primary btn-sm px-2 py-2 select-btn"
                                                data-therapist-id="@therapist.Id">
                                            Select
                                        </button>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Nút điều hướng Previous -->
        <button class="carousel-control-prev" type="button" id="prevBtn" onclick="changePage(-1)"
                style="position: absolute; left: 10px; width: 40px; height: 40px;
                background-color: rgba(0, 0, 0, 0.6); border-radius: 50%;
                top: 50%; transform: translateY(-50%); transition: all 0.3s ease-in-out;
                opacity: 0.7; z-index: 10;"
        @(Model.CurrentPage <= 1 ? "disabled" : "")>            
            <i class="fas fa-chevron-left" style="font-size: 20px; color: white;"></i>
        </button>

        <!-- Nút điều hướng Next -->
        <button class="carousel-control-next" type="button" id="nextBtn" onclick="changePage(1)"
                style="position: absolute; right: 10px; width: 40px; height: 40px;
                background-color: rgba(0, 0, 0, 0.6); border-radius: 50%;
                top: 50%; transform: translateY(-50%); transition: all 0.3s ease-in-out;
                opacity: 0.7; z-index: 10;"
        @(Model.CurrentPage >= Model.TotalPage ? "disabled" : "")>
            <i class="fas fa-chevron-right" style="font-size: 20px; color: white;"></i>
        </button>
    </div>

    <div class="text-center mt-3">
        <span id="pageIndicator" style="font-size: 1rem;">Page @Model.CurrentPage of @Model.TotalPage</span>
    </div>
</div>
